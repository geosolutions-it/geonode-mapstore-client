# Copy to `.env` and adjust.

# --- Dev server ---
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# --- Modes 2 & 3: single-origin reverse proxy via Vite ---
# Leave empty for Mode 1 (Django serves the shell at /manage/, Vite only
# serves JS modules; same-origin API calls).
#
# Set to a GeoNode URL to make Vite reverse-proxy everything (catalogue,
# API, auth, static, ...) to that target. Open http://localhost:5173/.
# Examples:
#   VITE_PROXY_TARGET=http://localhost:8000
#   VITE_PROXY_TARGET=https://stable.demo.geonode.org
VITE_PROXY_TARGET=

# --- Mode 3 only ---
# When VITE_PROXY_TARGET is set, /manage/* is served by Vite locally and
# the admin app shell has no GeoNode chrome (Mode 2).
#
# Set this to "true" to ALSO forward /manage/<html-routes> to upstream
# Django, so it renders the chrome-wrapped shell (Mode 3). Vite still
# serves /manage/src/*, /manage/@*, /manage/node_modules/* locally for HMR.
# Requires the upstream to have the admin-app branch installed.
VITE_PROXY_MANAGE=

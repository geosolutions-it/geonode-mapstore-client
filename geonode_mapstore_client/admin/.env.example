# Copy to `.env` and adjust.

# --- Dev server ---
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# --- Mode 2 only: standalone Vite with API proxy ---
# Leave empty for the default workflow (Django serves the shell at /manage/,
# Vite only serves JS modules; same-origin API calls).
#
# Set to a GeoNode URL to make Vite proxy API calls to that target. Useful
# when you want to develop against a remote staging server without running
# GeoNode locally. Example:
#   VITE_PROXY_TARGET=http://localhost:8000
#   VITE_PROXY_TARGET=https://staging.geonode.example.org
VITE_PROXY_TARGET=
